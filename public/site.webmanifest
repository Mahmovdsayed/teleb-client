{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "id": "/?source=pwa",
  "name": "Teleb Furniture | طلب للأثاث",
  "short_name": "Teleb",
  "description": "Teleb Furniture (طلب للأثاث) - Leading Egyptian manufacturer of premium knocked-down and modern furniture. Browse luxury bedrooms, living rooms, dining tables, and chairs crafted with authentic Egyptian artisan touch.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#93784b",
  "theme_color": "#93784b",
  "lang": "en",
  "dir": "auto",
  "categories": ["shopping", "lifestyle", "business"],
  "prefer_related_applications": false,
